<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/CSS/index.css">
    <title><%= local.title %></title>
</head>
<body>
    
</body>
</html>


<div class="hp">

  <!-- Hero -->
  <section class="hp-hero">
    <div class="hp-container">
      <h1>Your health matters. Let's make it simple.</h1>
      <p>Clear, trustworthy guidance on nutrition, fitness, sleep and mental wellbeing, written to help you and your family live healthier every day.</p>
      <div class="hp-hero-actions">
        <a href="/blog" class="hp-btn hp-btn-light">Read the blog</a>
        <a href="/about" class="hp-btn hp-btn-light">About us</a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="hp-section">
    <div class="hp-container hp-split">
      <img src="/img/happy-female-doctor-giving-high-fie-little-boy-who-came-with-father-hospital.jpg" alt="A smiling doctor greeting a young patient at the hospital">
      <div>
        <p class="hp-label">Caring for you</p>
        <h2>Healthcare information you can trust</h2>
        <p>Good health starts with good information. We turn complicated medical topics into plain language, so you can feel confident about the choices you make for yourself and the people you love.</p>
        <ul class="hp-list">
          <li>Easy-to-read guides, free of jargon</li>
          <li>Practical tips you can use today</li>
          <li>Topics for every age and stage of life</li>
        </ul>
        <a href="/about" class="hp-btn hp-btn-primary">Learn more about us</a>
      </div>
    </div>
  </section>

  <!-- Topics -->
  <section class="hp-section hp-alt">
    <div class="hp-container">
      <div class="hp-heading">
        <p class="hp-label">What we cover</p>
        <h2>Everything you need for a healthier life</h2>
      </div>
      <div class="hp-cards">
        <div class="hp-card">
          <h3>Nutrition</h3>
          <p>Simple advice on balanced eating, meal planning and building habits that last.</p>
        </div>
        <div class="hp-card">
          <h3>Fitness</h3>
          <p>Easy ways to move more, from gentle walks to full workout routines.</p>
        </div>
        <div class="hp-card">
          <h3>Mental wellbeing</h3>
          <p>Tools for managing stress, building resilience and looking after your mind.</p>
        </div>
        <div class="hp-card">
          <h3>Sleep and recovery</h3>
          <p>Practical steps for better rest, more energy and a healthier daily rhythm.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="hp-stats">
    <div class="hp-container hp-stats-grid">
      <div class="hp-stat"><strong>100+</strong> <span>Health articles</span></div>
      <div class="hp-stat"><strong>4</strong> <span>Core topics</span></div>
      <div class="hp-stat"><strong>10k+</strong> <span>Monthly readers</span></div>
      <div class="hp-stat"><strong>24/7</strong> <span>Free access</span></div>
    </div>
  </section>

  <!-- Closing call to action -->
  <section class="hp-section hp-cta">
    <div class="hp-container">
      <h2>Ready to take the next step?</h2>
      <p>Browse our latest articles, or get in touch if there's a topic you'd like us to cover.</p>
      <a href="/blog" class="hp-btn hp-btn-primary">Start reading</a>
    </div>
  </section>

</div>